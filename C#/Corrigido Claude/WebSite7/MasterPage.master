<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 { width: 100%; }
        .auto-style2 { height: 23px; }
        .auto-style3 { height: 23px; width: 561px; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <div></div>
        <table class="auto-style1">
            <tr>
                <td class="auto-style3">
                    <a href="categoria.aspx">Categoria</a>&nbsp;&nbsp;
                    <a href="gravadora.aspx">Gravadora</a>&nbsp;&nbsp;
                    <a href="alb_cat.aspx">Lista de Álbuns por Categoria</a>&nbsp;&nbsp;
                    <a href="alb_grav.aspx">Lista de Álbuns por Gravadora</a>
                </td>
                <td class="auto-style2">
                    &nbsp;Busca:&nbsp;
                    <asp:TextBox ID="f_busca" runat="server" Width="222px"></asp:TextBox>
                    <asp:Button ID="Button1" runat="server" OnClick="Button1_Click2" style="height: 26px" Text="OK" />
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
            <tr>
                <td colspan="2">Sidnei Jr</td>
            </tr>
            <tr>
                <td colspan="2">&nbsp;</td>
            </tr>
        </table>
    </form>
</body>
</html>
